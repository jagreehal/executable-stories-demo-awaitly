{
  "name": "executable-stories-demo-awaitly",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "STORY_REPORT=1 vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.include='src/rob/**'",
    "mutation": "stryker run",
    "mutation:incremental": "stryker run --incremental",
    "demo:reset": "cp src/rob/index.test.ts.before src/rob/index.test.ts",
    "dev": "bun --hot scripts/dev.ts",
    "diagram": "awaitly-analyze ./src/awaitly.test.ts",
    "diagram:watch": "awaitly-analyze ./src/awaitly.test.ts --watch",
    "diagram:html": "awaitly-analyze ./src/awaitly.test.ts --html"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/eslint-parser": "8.0.7",
    "@babel/preset-typescript": "8.0.7",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/bun": "latest",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "executable-stories-formatters": "2.0.0",
    "executable-stories-vitest": "8.12.2",
    "live-server": "1.2.2",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "awaitly": "6.2.0",
    "awaitly-analyze": "0.32.1",
    "eslint-plugin-awaitly": "4.1.1"
  }
}